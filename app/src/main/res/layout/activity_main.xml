<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/calculator_background">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/calculator_background"
            app:title="@string/standard"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/ic_menu" />

        <!-- Display Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end|bottom"
            android:padding="@dimen/display_padding"
            android:background="@color/display_background">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="@dimen/expression_text_size"
                android:textColor="@color/text_expression"
                android:maxLines="1"
                android:ellipsize="start"
                tools:text="12 + 8 =" />

            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="@dimen/display_text_size"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="48sp"
                android:text="0"
                tools:text="20" />

        </LinearLayout>

        <!-- Memory Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@color/memory_row_background">

            <Button
                android:id="@+id/btnMC"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_mc"
                android:textSize="@dimen/memory_text_size"
                android:textColor="@color/text_secondary"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnMR"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_mr"
                android:textSize="@dimen/memory_text_size"
                android:textColor="@color/text_secondary"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnMPlus"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_m_plus"
                android:textSize="@dimen/memory_text_size"
                android:textColor="@color/text_secondary"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnMMinus"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_m_minus"
                android:textSize="@dimen/memory_text_size"
                android:textColor="@color/text_secondary"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnMS"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/btn_ms"
                android:textSize="@dimen/memory_text_size"
                android:textColor="@color/text_secondary"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Calculator Buttons Grid -->
        <!-- Row 1: %, CE, C, ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPercent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_percent"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnClearEntry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_ce"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_clear"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_backspace"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Row 2: 1/x, x², √x, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFraction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_fraction"
                android:textSize="@dimen/button_text_size_small"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnSquare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_square"
                android:textSize="@dimen/button_text_size_small"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnSquareRoot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_function"
                android:text="@string/btn_sqrt"
                android:textSize="@dimen/button_text_size_small"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_operator"
                android:text="@string/btn_divide"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Row 3: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="7"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="8"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="9"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_operator"
                android:text="@string/btn_multiply"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Row 4: 4, 5, 6, − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="4"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="5"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="6"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnSubtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_operator"
                android:text="@string/btn_subtract"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Row 5: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="1"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="2"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="3"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_operator"
                android:text="@string/btn_add"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Row 6: +/−, 0, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNegate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="@string/btn_negate"
                android:textSize="@dimen/button_text_size_small"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="0"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnDecimal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_number"
                android:text="@string/btn_decimal"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/bg_button_equals"
                android:text="@string/btn_equals"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/drawer_background"
        app:itemTextColor="@color/text_primary"
        app:itemIconTint="@color/text_primary"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
